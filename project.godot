; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bottlenauts"
run/main_scene="res://scenes/menus/titlescreen/TitleScreen.tscn"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.0", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://src/autoload/SignalBus.cs"
Audio="*res://src/autoload/Audio.cs"
Settings="*res://src/autoload/Settings.cs"
MatchSettingsState="*res://src/autoload/MatchSettingsState.cs"
TextHelper="*res://src/autoload/TextHelper.cs"
Graphics="*res://src/autoload/Graphics.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false

[dotnet]

project/assembly_name="Bottlenauts"

[input]

pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="Team 1"
3d_physics/layer_2="Team 2"
3d_physics/layer_3="Team 3"
3d_physics/layer_4="Team 4"
3d_physics/layer_5="Team 5"
3d_physics/layer_6="Team 6"
3d_physics/layer_7="Team 7"
3d_physics/layer_8="Team 8"
3d_physics/layer_9="Team 1 Bomb"
3d_physics/layer_10="Team 2 Bomb"
