; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bottlenauts"
run/main_scene="res://scenes/menus/titlescreen/TitleScreen.tscn"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.0", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://src/autoload/SignalBus.cs"
Settings="*res://src/autoload/Settings.cs"
Audio="*res://src/autoload/Audio.cs"
Graphics="*res://src/autoload/Graphics.cs"
TextHelper="*res://src/autoload/TextHelper.cs"
MatchSettingsState="*res://src/autoload/MatchSettingsState.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false

[dotnet]

project/assembly_name="Bottlenauts"

